		(uuid "1a232212-ac38-433d-b3eb-d6230eae8fad")
	)
	(text "2. F1: hold current about 2x measured strip current, rated >= 30 V (e.g. Littelfuse RXEF020). Footprint is a 5 mm-pitch disc stand-in."
		(exclude_from_sim no)
		(at 27.94 142.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "30b0741f-bdf0-42f7-8d2e-56909913403f")
	)
	(text "5. U1 isolates the printer's LED circuit (J2) from the 24 V side. Use only the +24V/GND pins of the AMS cable."
		(exclude_from_sim no)
		(at 27.94 157.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "543836ba-e674-4636-98a9-6b914b12ba61")
	)
	(text "6. D2 is a unidirectional TVS (P6KE30A), drawn with a Zener symbol; cathode to the fused 24 V line."
		(exclude_from_sim no)
		(at 27.94 162.56 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7a23070e-fe0e-4167-9084-c6be690579be")
	)
	(text "4. Gate approx. 12 V from R3/R2 divider; C3 filters PWM/glitches (tau approx. 24 ms). Strip defaults OFF."
		(exclude_from_sim no)
		(at 27.94 152.4 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "845e9b7a-e2fb-4f08-a719-37785d2cff19")
	)
	(text "24 V input & protection"
		(exclude_from_sim no)
		(at 27.94 38.1 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "95f26349-a94c-4622-b136-73585109c0a1")
	)
	(text "3. Q1 BS170 pinout D-G-S. A 2N7000 (S-G-D) needs a different footprint pin map; OK only below 150 mA."
		(exclude_from_sim no)
		(at 27.94 147.32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a316d6dd-345e-42f0-ba01-57f965b6ffd9")
	)
	(text "Notes:"
