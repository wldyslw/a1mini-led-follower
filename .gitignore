# --- KiCad backups and autosaves ---
*-backups/
_autosave-*
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-save.kicad_pcb
*-save.pro
\#auto_saved_files\#
.history/

# --- KiCad local state (per-user, not part of the design) ---
# Layer visibility, open sheets, window layout, etc.
*.kicad_prl
fp-info-cache
~*.lck
*.lck

# --- Generated files (re-create them from the design) ---
*.net
*.dsn
*.ses
*.tmp

# --- Fabrication outputs ---
# Gerbers, drill files and assembly files are regenerated from the board.
# Attach a zipped set to a GitHub Release instead of committing them.
# Delete these lines if you'd rather keep them in the repo.
gerbers/
fabrication/
production/
*.zip

# --- OS and editor clutter ---
.DS_Store
Thumbs.db
Desktop.ini
*~
.vscode/
.idea/
